{
  "name": "@notifications/inbox",
  "version": "0.0.0",
  "scripts": {
    "prebuild": "copyfiles -u 1 src/**/*.handlebars dist && touch .env",
    "build": "tsc -p tsconfig.json",
    "build:watch": "yarn prebuild && tsc -p tsconfig.json --watch",
    "start": "node --trace-warnings --abort-on-uncaught-exception --unhandled-rejections=strict dist/index.js",
    "test": "jest --forceExit --detectOpenHandles --coverage --verbose",
    "lint:check": "npx eslint . --ext .ts",
    "lint:fix": "npx eslint . --ext .ts --fix",
    "update:snapshots": "jest --updateSnapshot"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@dcl/eslint-config": "^2.1.0",
    "@dcl/test-helpers": "^0.2.0",
    "@types/node": "^20.11.24",
    "copyfiles": "^2.4.1",
    "sql-template-strings": "^2.2.2",
    "typescript": "^5.3.3"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "tabWidth": 2
  },
  "dependencies": {
    "@dcl/core-commons": "^0.10.1",
    "@dcl/crypto-middleware": "^6.2.0",
    "@dcl/features-component": "^1.0.2",
    "@dcl/fetch-component": "^1.1.1",
    "@dcl/http-commons": "^2.0.0",
    "@dcl/http-server": "^2.1.0",
    "@dcl/metrics": "^1.0.1",
    "@dcl/pg-component": "^0.2.0",
    "@dcl/schema-validator-component": "^1.0.1",
    "@dcl/schemas": "26.5.0",
    "@notifications/common": "0.0.0",
    "@well-known-components/env-config-provider": "^1.2.0",
    "@well-known-components/interfaces": "^1.5.2",
    "@well-known-components/logger": "^3.1.3",
    "handlebars": "^4.7.8"
  }
}
